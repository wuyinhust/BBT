          "stringUnit" : {
            "state" : "translated",
            "value" : "慢熱觀察"
          }
        }
      }
    },
    "慢热认真、需要安全感，是先站稳再一步步靠近世界的小朋友。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoughtful and slow to warm, finding solid ground before taking each small step toward the world."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢熱認真、需要安全感，會先站穩，再一步步靠近世界。"
          }
        }
      }
    },
    "慢热谨慎、观察力强，安全感足够后会认真靠近。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cautious and observant, opening up with real intention once they feel safe."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢熱謹慎、觀察力強，安全感足夠後會認真靠近。"
          }
        }
      }
    },
    "慢节奏、低刺激偏好，需要更从容的过渡时间。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefers a slower, quieter world with plenty of time for gentle transitions."
