    "亲喂换算按当前月龄估算；尿量换算字段暂未上线，后续记录尿布重量后会补全。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nursing equivalents are estimated from the baby’s current age. Urine-volume estimates will arrive with diaper-weight tracking."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親餵換算會依目前月齡估算；尿量換算尚未推出，日後支援尿布重量記錄時會補上。"
          }
        }
      }
    },
    "亲近爱撒娇、状态切换丰富，是今天想贴贴、明天想探索的小浪花。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affectionate and expressive—ready to cuddle today and explore tomorrow."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親近愛撒嬌、狀態變化豐富，是今天想貼貼、明天想探索的小浪花。"
          }
        }
      }
    },
